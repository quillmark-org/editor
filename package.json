{
  "name": "@quillmark/editor",
  "version": "0.1.0",
  "description": "Embeddable Svelte 5 editor for QuillMark documents (markdown, visual, and preview views).",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "predev": "node scripts/package-quills.js",
    "dev": "vite dev",
    "prebuild": "node scripts/package-quills.js",
    "build": "vite build",
    "preview": "vite preview",
    "package": "svelte-kit sync && svelte-package && publint",
    "prepublishOnly": "npm run package",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --ignore references",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --ignore references --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles/theme.css": "./dist/styles/theme.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "@quillmark/wasm": "^0.85.0",
    "svelte": "^5"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.0",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.11.3",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.6",
    "@lezer/highlight": "^1.2.3",
    "@lexical/code-core": "^0.44.0",
    "@lexical/history": "^0.44.0",
    "@lexical/link": "^0.44.0",
    "@lexical/list": "^0.44.0",
    "@lexical/markdown": "^0.44.0",
    "@lexical/rich-text": "^0.44.0",
    "@lexical/selection": "^0.44.0",
    "@lexical/table": "^0.44.0",
    "@lexical/utils": "^0.44.0",
    "lexical": "^0.44.0",
    "lucide-svelte": "^0.548.0",
    "yaml": "^2.8.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@airmark/quiver": "^0.23.0",
    "@quillmark/quiver": "^0.11.0",
    "@quillmark/wasm": "0.85.0",
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.56.1",
    "@sveltejs/package": "^2.3.7",
    "@sveltejs/vite-plugin-svelte": "^6.2.0",
    "@types/node": "^22.7.5",
    "publint": "^0.3.5",
    "svelte": "^5.39.5",
    "svelte-check": "^4.3.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vite-plugin-wasm": "^3.5.0",
    "vitest": "^3.2.4"
  }
}
